#!/bin/bash
#
# Translate the Omarchy menu into the system language.
#
# The menu is the one part of the Omarchy shell that is data, not code: rows
# live in JSONC and the user extension at
# ~/.config/omarchy/extensions/omarchy-menu.jsonc overrides them by id. Every
# other string in the shell -- panel headings, tooltips, buttons -- is a
# literal inside some plugin's QML with no hook to reach it, so the menu is as
# far as translation goes without forking plugins.
#
# Overrides have to re-declare the whole row. The shell's own comment promises
# a per-key merge, but parseMenuJsonc normalizes each entry to a full object
# with empty-string defaults before merging, so {"label":"Omrežje"} lands as a
# row with no icon and no action. Rows are therefore copied wholesale from the
# defaults with only the label and title swapped -- which is why the block
# records the hash of the file it was copied from, and why `status` reports it
# stale once that file moves under it.
#
# Usage: menu-translate status
#        menu-translate apply <locale>
#        menu-translate remove

set -euo pipefail

OMARCHY_ROOT="${OMARCHY_PATH:-/usr/share/omarchy}"
DEFAULT_MENU="$OMARCHY_ROOT/default/omarchy/omarchy-menu.jsonc"
USER_MENU="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
TABLE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/translations"

BEGIN_RE='^[[:space:]]*// >>> omarchy-language begin'
END_RE='^[[:space:]]*// <<< omarchy-language end'

fail() {
  echo "menu-translate: $*" >&2
  exit 1
}

# The shell reads JSONC: whole-line // comments and trailing commas are both
# stripped before JSON.parse. Mirror exactly that, so what validates here is
# what the shell will accept -- no stricter, no looser.
strip_jsonc() {
  perl -0777 -pe 's{^\s*//[^\n]*\n}{}gm; s/,(\s*[}\]])/$1/g'
}

# Locale short name (sl_SI.UTF-8 -> sl_SI), which is how tables are named.
table_for() {
  local locale="${1%%.*}"
  locale="${locale%%@*}"
  echo "$TABLE_DIR/$locale.tsv"
}

available_locales() {
  local table
  for table in "$TABLE_DIR"/*.tsv; do
    [[ -e $table ]] || continue
    basename "$table" .tsv
  done
}

source_hash() {
  sha256sum "$DEFAULT_MENU" | cut -c1-12
}

# Everything in the user's file that is not ours, verbatim -- their own rows
# and their own comments both. Printed without the enclosing braces so the
# caller can put a fresh object around it.
user_body() {
  [[ -f $USER_MENU ]] || return 0
  awk -v begin_re="$BEGIN_RE" -v end_re="$END_RE" '
    $0 ~ begin_re { skipping = 1 }
    !skipping { print }
    $0 ~ end_re { skipping = 0 }
  ' "$USER_MENU" | perl -0777 -pe 's/\A\s*\{//; s/\}\s*\z//'
}

managed_block() {
  local locale="$1" table entries rows
  table=$(table_for "$locale")
  [[ -f $table ]] || fail "no translation table for $locale"

  # Tab-separated English<TAB>translation, blank lines and # comments ignored.
  local map
  map=$(jq -R -s '
    split("\n")
    | map(select(length > 0) | select(startswith("#") | not))
    | map(split("\t"))
    | map(select(length >= 2 and (.[1] | length) > 0))
    | map({ (.[0]): .[1] })
    | add // {}
  ' <"$table")

  entries=$(strip_jsonc <"$DEFAULT_MENU" | jq -r --argjson t "$map" '
    to_entries[]
    | .key as $id
    | .value as $row
    | ($row.label // $id) as $label
    | ($t[$label] // $label) as $translated
    | ($row.title // "") as $title
    | $row
      + { label: $translated }
      + (if $title != "" then { title: ($t[$title] // $title) } else {} end)
      # The English word stays searchable: menu search scores a description
      # match, so typing "network" still finds Omrežje. Only filled in where
      # the row had no description of its own to lose.
      + (if ($row.description // "") == "" and $translated != $label
         then { description: $label } else {} end)
    | "  \($id | @json): \(@json),"
  ')

  # The menu leads with items.root.label, and the shell synthesizes that row
  # itself -- labelled "Go" -- when no source provides one. So the one string
  # the defaults never spell is the first one anybody reads. Supply the row,
  # unless the defaults have grown one of their own.
  local root_row
  root_row=$(strip_jsonc <"$DEFAULT_MENU" | jq -r --argjson t "$map" '
    if has("root") then empty
    else
      ($t["Go"] // "") as $label
      | if $label == "" then empty
        else "  \"root\": {\"label\": \($label | @json)}," end
    end
  ')
  if [[ -n $root_row ]]; then
    entries="$root_row"$'\n'"$entries"
  fi

  rows=$(printf '%s\n' "$entries" | grep -c .)
  printf '  // >>> omarchy-language begin locale=%s source=%s rows=%s\n' \
    "$(basename "$(table_for "$locale")" .tsv)" "$(source_hash)" "$rows"
  printf '  // Generated by the Language plugin. Edits here are overwritten;\n'
  printf '  // put your own rows outside this block.\n'
  printf '%s\n' "$entries"
  printf '  // <<< omarchy-language end\n'
}

# Assemble, check it against the shell's own reader, then move it into place.
# A file that fails to parse is dropped whole by the shell (printErrors is
# off), taking the user's own rows down with it, so nothing is written until
# jq has agreed the result is readable.
TMP_FILE=""
cleanup() { [[ -n ${TMP_FILE:-} ]] && rm -f "$TMP_FILE"; return 0; }
trap cleanup EXIT

write_menu() {
  local body="$1" tmp
  tmp=$(mktemp)
  TMP_FILE="$tmp"

  {
    printf '{\n'
    printf '%s' "$body"
    printf '\n}\n'
  } >"$tmp"

  strip_jsonc <"$tmp" | jq -e . >/dev/null 2>&1 \
    || fail "generated menu is not valid JSONC; nothing written"

  mkdir -p "$(dirname "$USER_MENU")"
  [[ -f $USER_MENU ]] && cp -p "$USER_MENU" "$USER_MENU.bak"
  cat "$tmp" >"$USER_MENU"
}

cmd_status() {
  local state="off" locale="" rows=0 source=""
  if [[ -f $USER_MENU ]] && grep -qE "$BEGIN_RE" "$USER_MENU"; then
    local header
    header=$(grep -E "$BEGIN_RE" "$USER_MENU" | head -1)
    locale=$(sed -nE 's/.*locale=([^ ]*).*/\1/p' <<<"$header")
    source=$(sed -nE 's/.*source=([^ ]*).*/\1/p' <<<"$header")
    rows=$(sed -nE 's/.*rows=([0-9]*).*/\1/p' <<<"$header")
    if [[ $source == "$(source_hash)" ]]; then state="on"; else state="stale"; fi
  fi
  printf 'state=%s locale=%s rows=%s available=%s\n' \
    "$state" "${locale:-}" "${rows:-0}" "$(available_locales | tr '\n' ',' | sed 's/,$//')"
}

cmd_apply() {
  local locale="${1:-}"
  [[ -n $locale ]] || fail "apply needs a locale"
  local body
  body="$(managed_block "$locale")"$'\n'"$(user_body)"
  write_menu "$body"
}

cmd_remove() {
  [[ -f $USER_MENU ]] || return 0
  grep -qE "$BEGIN_RE" "$USER_MENU" || return 0
  write_menu "$(user_body)"
}

case "${1:-status}" in
  status) cmd_status ;;
  apply)  shift; cmd_apply "${1:-}" ;;
  remove) cmd_remove ;;
  -h | --help) sed -n '2,25p' "${BASH_SOURCE[0]}" | sed 's|^# \{0,1\}||' ;;
  *) fail "unknown command '$1'" ;;
esac
